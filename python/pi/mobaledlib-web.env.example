# Datei-Version: 1.04 (2026-10-14) - mobaledlib-web.env.example
# Einstellungen des Dienstes mobaledlib-web (Kopie nach /etc/mobaledlib-web.env, Rechte: nur root lesbar)
# 0.0.0.0 = im ganzen Netz erreichbar, 127.0.0.1 = nur auf dem Pi selbst
MLL_HOST=0.0.0.0
MLL_PORT=8080
# Passwortschutz (HTTP Basic). Ohne MLL_PASSWORD ist die Oberflaeche im Netz fuer jeden offen!
# Voreinstellung der Installation: Benutzer mobaledlib, Passwort mobaledlib. Im Programm laesst es sich aendern
# (Programm Einstellungen - Zugriff ueber das Netz); das dort gesetzte Passwort geht diesem hier vor.
MLL_USER=mobaledlib
MLL_PASSWORD=mobaledlib
# Menue Datei: Raspberry Pi herunterfahren / neu starten (braucht die sudo-Regel, die install_pi.sh anlegt)
MLL_ALLOW_SHUTDOWN=1
# Protokoll (Datei webmobaledlib.log im Datenordner des Benutzers): Stufe DEBUG (Standard), INFO, WARNING, ERROR, CRITICAL
# MLL_LOGLEVEL=DEBUG
# Anderer Dateiname (ohne Pfad: im Datenordner), oder stdout = keine Datei
# MLL_LOGFILE=webmobaledlib.log
