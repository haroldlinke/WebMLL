# Einstellungen des Dienstes mobaledlib-web (Kopie nach /etc/mobaledlib-web.env, Rechte: nur root lesbar)
# 0.0.0.0 = im ganzen Netz erreichbar, 127.0.0.1 = nur auf dem Pi selbst
MLL_HOST=0.0.0.0
MLL_PORT=8080
# Passwortschutz (HTTP Basic). Ohne MLL_PASSWORD ist die Oberflaeche im Netz fuer jeden offen!
MLL_USER=mobaledlib
MLL_PASSWORD=hier-ein-eigenes-passwort
